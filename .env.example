# ==============================================================================
# File Flux — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.
# ==============================================================================

# ── Domain & TLS (production only) ──────────────────────────────────────────
DOMAIN=fileflux.example.com
ACME_EMAIL=admin@example.com

# ── Database ────────────────────────────────────────────────────────────────
DB_USER=fileflux
DB_PASSWORD=          # REQUIRED — generate with: openssl rand -base64 32
DB_NAME=fileflux
DB_SSLMODE=disable    # set to "require" when using external DB with TLS

# ── Backend ─────────────────────────────────────────────────────────────────
JWT_SECRET=           # REQUIRED — generate with: openssl rand -base64 64
ENV=production        # development | production
LOG_LEVEL=info        # debug | info | warn | error
LOG_FORMAT=json       # json | text

# ── Ports (development/quick-start only, ignored in production TLS mode) ───
API_PORT=3001
WS_PORT=3002
FRONTEND_PORT=3000

# ── Frontend ────────────────────────────────────────────────────────────────
API_URL=/api          # relative path; set full URL for split deployments

# ── Agent ───────────────────────────────────────────────────────────────────
AGENT_TOKEN=          # REQUIRED — generate with: openssl rand -hex 32
AGENT_NAME=Central-Agent

# ── Monitoring (production only) ────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=     # REQUIRED for production
